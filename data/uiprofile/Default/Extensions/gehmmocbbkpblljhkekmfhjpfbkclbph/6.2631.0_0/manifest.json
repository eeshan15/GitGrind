   "web_accessible_resources": [ "index.html", "loading.html", "content/injected/logo-autofill-known.svg", "content/injected/logo-autofill-unknown.svg", "content/injected/loader.png", "content/webui/index.html", "content/injected/vendors.js", "content/pageScripts/dashlane-webauthn-page-script.js", "content/pageScripts/dashlane-shadow-dom-page-script.js", "content/pageScripts/dashlane-top-layer-page-script.js", "content/pageScripts/dashlane-webkit-animation-page-script.js" ]
}
