         "32": "icons/action/icon_loading@2x.png"
      },
      "default_popup": "popup/index.html",
      "default_title": "Dashlane"
   },
   "commands": {
      "_execute_browser_action": {
         "suggested_key": {
            "default": "Ctrl+Shift+L"
         }
      }
   },
   "content_scripts": [ {
      "all_frames": true,
      "exclude_globs": [ "*://www.google.*/*sourceid=chrome-instant*", "*://www.google.*/blank.html*" ],
      "exclude_matches": [ "*://platform.twitter.com/widgets/*", "*://www.facebook.com/plugins/*", "*://plusone.google.com/_/+1/*", "*://challenges.cloudflare.com/*", "*://locations.texastechfcu.org/*" ],
      "js": [ "content/contentScripts/kwift.CHROME.js", "content/injected/vendors.js" ],
      "match_about_blank": false,
      "matches": [ "http://*/*", "https://*/*" ],
      "run_at": "document_end"
   }, {
      "all_frames": true,
      "js": [ "content/contentScripts/dashlane-saml-intercept-script.js" ],
      "match_about_blank": false,
      "matches": [ "https://*/*" ],
      "run_at": "document_start"
   }, {
      "js": [ "content/contentScripts/dashlane-turnstile-bridge.js" ],
      "matches": [ "https://accounts.dashlane.com/securitycheck", "https://accounts.dashlane.com/securitycheck?*" ],
      "run_at": "document_start"
   }, {
      "all_frames": true,
      "exclude_globs": [ "*://www.google.*/*sourceid=chrome-instant*", "*://www.google.*/blank.html*" ],
      "exclude_matches": [ "*://platform.twitter.com/widgets/*", "*://www.facebook.com/plugins/*", "*://plusone.google.com/_/+1/*", "*://challenges.cloudflare.com/*", "*://locations.texastechfcu.org/*" ],
      "js": [ "content/contentScripts/dashlane-page-scripts-installer.js", "content/contentScripts/dashlane-shadow-dom-page-script-installer.js" ],
      "matches": [ "https://*/*" ],
      "run_at": "document_start"
   }, {
      "all_frames": true,
      "exclude_globs": [ "*://www.google.*/*sourceid=chrome-instant*", "*://www.google.*/blank.html*" ],
      "exclude_matches": [ "*://platform.twitter.com/widgets/*", "*://www.facebook.com/plugins/*", "*://plusone.google.com/_/+1/*", "*://challenges.cloudflare.com/*", "*://locations.texastechfcu.org/*" ],
      "js": [ "content/contentScripts/dashlane-webkit-animation-page-script-installer.js" ],
      "matches": [ "https://*/*" ],
      "run_at": "document_start"
   } ],
   "content_security_policy": "script-src 'self' 'wasm-eval' 'wasm-unsafe-eval'; object-src 'self'",
   "default_locale": "en",
   "description": "__MSG_ExtensionShortDescription__",
   "icons": {
      "128": "icons/icon-dashlane-128px.png",
      "16": "icons/icon-dashlane-16px.png",
      "48": "icons/icon-dashlane-48px.png"
   },
   "key": "",
   "manifest_version": 2,
   "name": "__MSG_ExtensionName__",
   "optional_permissions": [ "downloads" ],
   "options_ui": {
      "open_in_tab": true,
      "page": "options/options.html"
   },
   "permissions": [ "http://*/*", "https://*/*", "contextMenus", "cookies", "idle", "privacy", "storage", "tabs", "unlimitedStorage", "scripting", "webRequest", "webRequestBlocking" ],
   "storage": {
      "managed_schema": "managed-storage-schema.json"
