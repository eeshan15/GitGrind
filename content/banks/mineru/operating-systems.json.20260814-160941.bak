    {
      "id": "mineru-filter1-volume3-5-24-50",
      "topic": "synchronization",
      "kind": "pyq",
      "type": "mcq",
      "marks": 2,
      "difficulty": "medium",
      "year": 2007,
      "text": "Processes P1 and P2 use critical\\_flag in the following routine to achieve mutual exclusion. Assume that critical\\_flag is initialized to FALSE in the main program. Consider the following statements. i. It is possible for both P1 and P2 to access critical\\_region concurrently. ii. This may lead to a deadlock. Which of the following holds?",
      "options": [
        "(i) is false (ii) is true",
        "Both (i) and (ii) are false",
        "(i) is true (ii) is false",
        "Both (i) and (ii) are true"
      ],
      "answer": [
        2
      ],
      "code_blocks": [
        {
          "lang": "txt",
          "code": "get_exclusive_access ()\n{\n    if (critical _flag == FALSE) {\n        critical_flag = TRUE ;\n        critical_region () ;\n        critical_flag = FALSE;\n    }\n}"
        }
      ],
      "origin": {
