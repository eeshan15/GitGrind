    {
      "id": "mineru-filter1-volume3-5-24-37",
      "topic": "synchronization",
      "kind": "pyq",
      "type": "mcq",
      "marks": 2,
      "difficulty": "medium",
      "year": 2014,
      "text": "Consider the procedure below for the Producer-Consumer problem which uses semaphores: Which one of the following is TRUE?",
      "options": [
        "The producer will be able to add an item to the buffer, but the consumer can never consume it.",
        "The consumer will remove no more than one item from the buffer.",
        "Deadlock occurs if the consumer succeeds in acquiring semaphore s when the buffer is empty.",
        "The starting value for the semaphore n must be 1 and not 0 for deadlock-free operation."
      ],
      "answer": [
        2
      ],
      "code_blocks": [
        {
          "lang": "javascript",
          "code": "semaphore n = 0;\nsemaphore s = 1;"
        },
        {
          "lang": "javascript",
          "code": "void producer()\n{\n    while(true)\n    {\n        produce();\n        semWait(s);\n        addToBuffer();\n        semSignal(s);\n        semSignal(n);\n    }\n}"
        },
        {
          "lang": "txt",
          "code": "void consumer()\n{\n    while(true)\n    {\n        semWait(s);\n        semWait(n);\n        removeFromBuffer();\n        semSignal(s);\n        consume();\n    }\n}"
        }
      ],
      "origin": {
        "source_file": "filter1_volume3.pdf",
        "volume": "filter1_volume3",
        "ref": "5.24.37",
