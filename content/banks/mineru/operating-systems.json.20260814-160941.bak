      "id": "mineru-filter1-volume3-5-10-1",
      "topic": "processes-threads",
      "kind": "pyq",
      "type": "mcq",
      "marks": 2,
      "difficulty": "medium",
      "year": 2005,
      "text": "Consider the following code fragment: Let $u, v$ be the values printed by the parent process and $x, y$ be the values printed by the child process. Which one of the following is TRUE?",
      "options": [
        "$u = x + 10$ and $v = y$",
        "$u = x + 10$ and $v! = y$",
        "$u + 10 = x$ and $v = y$",
        "$u + 10 = x$ and $v! = y$"
      ],
      "answer": [
        2
      ],
      "code_blocks": [
        {
          "lang": "txt",
          "code": "if (fork() == 0)\n{\n    a = a + 5;\n    printf(\"%d, %p n\", a, &a);\n}\nelse\n{\n    a = a - 5;\n    printf (\"%d, %p n\", a,& a);"
        }
      ],
      "origin": {
        "source_file": "filter1_volume3.pdf",
        "volume": "filter1_volume3",
        "ref": "5.10.1",
        "exam": "GATE CSE 2005 | Question: 72",
        "section": "Fork System Call",
        "paper_question": "72",
        "tags": [
          "gatecse-2005",
          "operating-system",
          "fork-system-call",
          "normal"
        ],
        "topic_source": "section"
      }
    },
