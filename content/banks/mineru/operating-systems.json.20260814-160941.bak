    {
      "id": "mineru-filter1-volume3-5-5-4",
      "topic": "deadlock",
      "kind": "pyq",
      "type": "mcq",
      "marks": 2,
      "difficulty": "medium",
      "year": 2004,
      "text": "In a certain operating system, deadlock prevention is attempted using the following scheme. Each process is assigned a unique timestamp, and is restarted with the same timestamp if killed. Let $P_h$ be the process holding a resource $R, P_r$ be a process requesting for the same resource $R$, and $T(P_h)$ and $T(P_r)$ be their timestamps respectively. The decision to wait or preempt one of the processes is based on the following algorithm. Which one of the following is TRUE?",
      "options": [
        "The scheme is deadlock-free, but not starvation-free",
        "The scheme is not deadlock-free, but starvation-free",
        "The scheme is neither deadlock-free nor starvation-free",
        "The scheme is both deadlock-free and starvation-free"
      ],
      "answer": [
        0
      ],
      "code_blocks": [
        {
          "lang": "txt",
          "code": "if T(Pr) < T(Ph) then\n    kill Pr\nelse wait"
        }
      ],
      "origin": {
        "source_file": "filter1_volume3.pdf",
        "volume": "filter1_volume3",
        "ref": "5.5.4",
        "exam": "GATE IT 2004 | Question: 63",
        "section": "Deadlock Prevention Avoidance Detection",
