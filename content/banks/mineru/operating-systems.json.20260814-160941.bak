      "type": "nat",
      "marks": 2,
      "difficulty": "medium",
      "year": 2026,
      "text": "Consider the following program snippet. Assume that the program compiles and runs successfully. Further, assume that the fork() system call is always successful in creating a process. The total number of times that the printf statement gets executed is \\_\\_\\_\\_. (answer in integer)",
      "options": [],
      "answer_value": 4.0,
      "tolerance": 0.0,
      "code_blocks": [
        {
          "lang": "c",
          "code": "int main () {\n    int i;\n    for (i = 0; i < 3; i++) {\n        if (fork() == 0) {\n            continue;\n        }\n        break;\n    }\n    printf(\"Hello!\");\n    return 0;\n}"
        }
      ],
      "origin": {
        "source_file": "filter1_volume3.pdf",
        "volume": "filter1_volume3",
        "ref": "5.10.7",
        "exam": "GATE CSE 2026 | Set 1 | Question: 53",
