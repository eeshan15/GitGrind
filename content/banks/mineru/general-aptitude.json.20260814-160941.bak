          "narrative-sequencing",
          "two-marks"
        ],
        "topic_source": "tag"
      },
      "needs_fix": "stem contains a table; check it flattened readably"
    },
    {
      "id": "mineru-vol1-11-9-1",
      "topic": "verbal",
      "kind": "pyq",
      "type": "mcq",
      "marks": 2,
      "difficulty": "medium",
      "year": 2010,
      "text": "Modern warfare has changed from large scale clashes of armies to suppression of civilian populations. Chemical agents that do their work silently appear to be suited to such warfare; and regretfully, there exist people in military establishments who think that chemical agents are useful tools for their cause. Which of the following statements best sums up the meaning of the above passage:",
      "options": [
        "Modern warfare has resulted in civil strife.",
        "Chemical agents are useful in modern warfare.",
        "Use of chemical agents in warfare would be undesirable.",
        "People in military establishments like to use chemical agents in war."
      ],
      "answer": [
        3
      ],
      "origin": {
        "source_file": "filter1_volume1.pdf",
        "volume": "vol1",
        "ref": "11.9.1",
        "exam": "GATE CSE 2010 | Question: 63",
        "section": "Passage Reading",
        "paper_question": "63",
        "tags": [
          "gatecse-2010",
          "verbal-aptitude",
          "passage-reading",
          "normal"
        ],
        "topic_source": "section"
      }
    },
