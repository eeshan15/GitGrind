    "$\\stackrel{\\textstyle\\mathbb{S}}{=}$",
    "$\\begin{array}{l}{{\\in_{\\mathcal{X}}}}\\\\ {{\\in{\\mathcal{Y}}}}\\end{array}$",
    "$\\underline{{\\land}}$"
   ],
