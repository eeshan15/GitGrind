   "answer_value": 7.0,
   "tolerance": 0,
   "code_blocks": [
    {
     "lang": "sql",
     "code": "SELECT ta.player FROM top_scorer AS ta\nWHERE ta.goals >ALL (SELECT tb.goals\n  FROM top_scorer AS tb\n  WHERE tb.country = 'Spain')\nAND ta.goals > ANY (SELECT tc.goals\n  FROM top_scorer AS tc\n  WHERE tc.country='Germany')"
    }
   ],
