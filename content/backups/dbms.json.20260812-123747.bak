   "type": "mcq",
   "marks": 2,
   "difficulty": "medium",
   "text": "Consider the following relational schema: • Student(school-id, sch-roll-no, sname, saddress) • Enrolment(school-id, sch-roll-no, erollno, examname) • ExamResult(erollno, examname, marks) What does the following SQL query output?",
   "options": [
    "for each school with more than students appearing in exams, the name of the school and the number of scored by its students",
    "for each school with more than students in it, the name of the school and the number of scored by its students",
    "for each school with more than students in it, the name of the school and the number of its students scoring in at least one exam",
    "nothing; the query has a syntax error"
   ],
   "answer": [
    3
   ],
   "code_blocks": [
    {
     "lang": "sql",
     "code": "SELECT sch-name, COUNT (*)\nFROM School C, Enrolment E, ExamResult R\nWHERE E.school-id = C.school-id\nAND\nE.examname = R.examname AND E.erollno = R.erollno\nAND\nR.marks = 100 AND E.school-id IN (SELECT school-id\n                      FROM student\n                      GROUP BY school-id\n                      HAVING COUNT (*) > 200)\nGROUP By school-id"
    }
