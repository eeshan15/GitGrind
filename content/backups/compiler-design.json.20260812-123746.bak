   "year": 2008,
   "text": "Consider the C program below. What does it print? \\# include <stdio.h>",
   "options": [
    "${\\mathfrak{H}},{\\mathfrak{H}}$",
    "$5,4$",
    "$4,5$",
    "${\\mathfrak{4}},{\\mathfrak{4}}$"
   ],
   "code_blocks": [
    {
     "lang": "txt",
     "code": "# define swap1 (a, b) tmp = a; a = b; b = tmp\nvoid swap2 ( int a, int b)\n{\n    int tmp;\n    tmp = a; a = b; b = tmp;\n}\nvoid swap3 (int*a, int*b)\n{\n    int tmp;\n    tmp = *a; *a = *b; *b = tmp;\n}\nint main ()\n{\n    int num1 = 5, num2 = 4, tmp;\n    if (num1 < num2) {swap1 (num1, num2);}\n    if (num1 < num2) {swap2 (num1 + 1, num2);}\n    if (num1 >= num2) {swap3 (&num1, &num2);}\n    printf (\"%d, %d\", num1, num2);\n}"
    }
   ],
