   "id": "mineru-filter1-volume2-5-8-11",
   "topic": "runtime-env",
   "kind": "pyq",
   "type": "mcq",
   "marks": 2,
   "difficulty": "medium",
   "year": 2006,
   "text": "Which one of the choices given below would be printed when the following program is executed?",
   "options": [
    "a=0,b=3 a = 0, b = 3",
    "a=3,b= 0 a = 1 2, b = 9",
    "a = 3,b = 6 a = 3, b = 6",
    "a = 6, b = 3 a = 1 5, b = 1 2"
   ],
   "answer": [
    3
   ],
   "code_blocks": [
    {
     "lang": "c",
     "code": "#include <stdio.h>\nvoid swap (int *x, int *y)\n{\n    static int *temp;\n    temp = x;\n    x = y;\n    y = temp;\n}\nvoid printab ()\n{\n    static int i, a = -3, b = -6;\n    i = 0;\n    while (i <= 4)\n    {\n        if ((i++)%2 == 1) continue;\n        a = a + i;\n        b = b + i;\n    }\n    swap (&a, &b);\n    printf(\"a = %d, b = %d\\n\", a, b);\n}\nmain()\n{\n    printab();\n    printab();\n}"
    }
   ],
   "origin": {
    "source_file": "filter1_volume2.pdf",
    "volume": "filter1_volume2",
