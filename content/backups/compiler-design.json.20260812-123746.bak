     "lang": "c",
     "code": "#include<stdio.h>\nvoid fun1(char* s1, char* s2){\n    char* temp;\n    temp = s1;\n    s1 = s2;\n    s2 = temp;\n}\nvoid fun2(char** s1, char** s2){\n    char* temp;\n    temp = *s1;\n    *s1 = *s2;\n    *s2 = temp;\n}\nint main(){\n    char *str1=\"Hi\", *str2 = \"Bye\";\n    fun1(str1, str2); printf(\"%s %s\", str1, str2);\n    fun2(&str1, &str2); printf(\"%s %s\", str1, str2);\n    return 0;\n}"
