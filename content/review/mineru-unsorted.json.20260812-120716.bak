      "marks": 2,
      "difficulty": "medium",
      "year": 2003,
      "text": "Consider the following assembly language program for a hypothetical processor and are bit registers. The meanings of various instructions are shown as comments. If the initial value of register A is A0 the value of register B after the program execution will be",
      "options": [
        "the number of bits in",
        "the number of bits in",
        "",
        ""
      ],
      "code_blocks": [
        {
          "lang": "",
          "code": "MOV B, #0          ;    $B \\leftarrow 0$\n    MOV C, #8          ;    $C \\leftarrow 8$\nZ:    CMP C, #0          ;    compare C with 0\n    JZ X                ;    jump to X if zero flag is set\n    SUB C, #1          ;    $C \\leftarrow C - 1$\n    RRC A, #1          ;    right rotate A through carry by one bit. Thus:\n                        ;    If the initial values of A and the carry flag are $a_7 \\ldots a_0$ and\n                        ;    $c_0$ respectively, their values after the execution of this\n                        ;    instruction will be $c_0a_7 \\ldots a_1$ and $a_0$ respectively.\n    JCY                ;    jump to Y if carry flag is set\n    JMP Z                ;    jump to Z\nY:    ADD B, #1          ;    $B \\leftarrow B + 1$\n    JMP Z                ;    jump to Z\nX:                    ;"
        }
      ],
      "origin": {
        "source_file": "filter1_volume3.pdf",
