+        view["section"] = r["section"]
+        view["paper_qno"] = r["paper_qno"]
+        items.append(view)
+    out = dict(row)
+    out["questions"] = items
+    out["sections"] = [
+        dict(s)
+        for s in conn.execute(
+            "SELECT * FROM paper_sections WHERE paper_id = ? ORDER BY sort_order",
+            (row["id"],),
+        )
+    ]
+    return out
+
