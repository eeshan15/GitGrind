+/* ------------------------------------------------------------------------- */
+/* Question figures                                                          */
+/* Images extracted from a source paper, shown under the question stem. Sized */
+/* down rather than cropped: a graph or a K-map is unreadable once clipped.   */
+/* ------------------------------------------------------------------------- */
+.q-figs {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 14px;
+  margin: 14px 0 4px;
+}
+
+.q-fig {
+  margin: 0;
+  padding: 8px;
+  max-width: 100%;
+  background: var(--bg2, #fff);
+  border: 1px solid var(--line, #d8dee4);
+  border-radius: 6px;
+}
+
+.q-fig-img {
+  display: block;
+  max-width: 100%;
+  max-height: 380px;
+  width: auto;
+  height: auto;
+  /* Diagrams are scanned on white. On a dark theme an unpadded transparent PNG
+     would read as a black rectangle, so keep a light plate behind every one. */
+  background: #fff;
+  border-radius: 3px;
+}
+
+.q-fig figcaption,
+.q-fig .q-fig-missing {
+  margin: 6px 0 0;
+  max-width: 420px;
+}
+
+.q-fig .q-fig-missing { color: var(--bad, #b4232a); }
+
+@media (max-width: 640px) {
+  .q-figs { gap: 10px; }
+  .q-fig-img { max-height: 260px; }
+}
